{
  "name": "peaceful-proxima",
  "type": "module",
  "version": "1.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && esbuild dist/server/entry.mjs --bundle --outfile=dist/client/_worker.js --format=esm --target=es2022 --external:cloudflare:workers && node -e \"fs.copyFileSync('wrangler.jsonc', 'dist/server/wrangler.json')\"",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && pnpm run check-links",
    "check-links": "node scripts/check-links.js",
    "generate:icons": "node scripts/generate-doodle-registry.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chat:dev": "partykit dev",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@imgly/background-removal": "^1.7.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.5.51",
    "@lucide/astro": "^1.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "chess.js": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "turn-arbiter": "^0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "partykit": "^0.0.115",
    "partysocket": "^1.3.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
