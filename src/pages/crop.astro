---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/primitives/Container.astro";
import DividerChessboard from "../components/primitives/DividerChessboard.astro";
import DoodleIcon from "../components/ui/DoodleIcon.astro";
import CropStudio from "../components/islands/CropStudio";
---

<BaseLayout
  title="ID Photo Studio"
  description="Free ID-photo tool: remove the background on your device, crop to 2x2 or 1x1, and export a print-ready file."
>
  <Container width="default" class="animate-reveal space-y-10 py-12">
    <header class="space-y-4">
      <span
        class="border-ink/20 bg-surface-subtle text-caption text-primary inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono font-semibold tracking-widest uppercase select-none"
      >
        <DoodleIcon name="image" class="text-primary size-3.5" />
        Lab · ID Photo Studio
      </span>
      <h1 class="text-h1 font-display text-text font-bold tracking-tight">ID Photo Studio</h1>
      <p class="text-body-large text-text-muted max-w-2xl leading-relaxed">
        Upload a portrait, cut out the background on your device, frame the face in a 2x2 or 1x1
        square, and export a print-ready file. Nothing is uploaded — the photo never leaves this
        browser.
      </p>
    </header>

    <DividerChessboard />

    <CropStudio client:visible />

    <p class="text-small text-text-muted max-w-2xl leading-relaxed">
      Looking for the write-up? Read the
      <a href="/experiments/id-photo-studio/" class="text-primary underline"> Lab notes</a>
      for the privacy model and backend contract. Just want a transparent cutout? Try the
      <a href="/remove-background" class="text-primary underline"> Background Remover</a>.
    </p>
  </Container>
</BaseLayout>
